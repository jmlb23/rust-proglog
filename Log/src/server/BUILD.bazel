load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "server",
    srcs = glob(["*.rs"]),
    crate_root = "lib.rs",
    visibility = ["//src:__pkg__"],
    deps = [
        "@local_crates//memmap2",
        "//protos:log_rust_proto"
    ],
)

rust_test(
    name = "lib_test",
    crate = ":server",
)
